PORT=5000
DATABASE_URL=postgres://postgres:Qwerty@234567@localhost:5432/attendance
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# Institutional email domains allowed to register (comma separated)
ALLOWED_EMAIL_DOMAINS=mulungushi.edu.zm

# TOTP: code rotates every TOTP_STEP seconds; TOTP_WINDOW = extra steps accepted either side
TOTP_STEP=5
TOTP_WINDOW=2

# Attendance rules
SESSION_DURATION_MINUTES=120
LATE_AFTER_MINUTES=15
MAX_GPS_ACCURACY_METERS=50
LECTURER_ROOM_TOLERANCE_METERS=50

# Schedule enforcement (turn off while testing outside class hours)
ENFORCE_SCHEDULE=true
SCHEDULE_EARLY_MINUTES=15
TIMEZONE=Africa/Lusaka
